yaml.dump 默认 allow_unicode=False，中文描述会被写成 \u6F14\u793A 形式。
YAML 语义上等价，但人不可读，且只做字符串匹配的 agent 读不到中文描述，
技能描述形同虚设。

- write_frontmatter 增加 allow_unicode=True
- 新增 3 项往返测试（中文 / 纯 ASCII / 嵌套与列表）

验证：pytest 3 passed；全量 161 passed（Windows 下 14 项 symlink 用例
因缺少创建符号链接权限失败，与本次改动无关，main 上同样失败）。
---
 src/neoskills/core/frontmatter.py      |  4 ++-
 tests/unit/test_frontmatter_unicode.py | 43 ++++++++++++++++++++++++++
 2 files changed, 46 insertions(+), 1 deletion(-)
 create mode 100644 tests/unit/test_frontmatter_unicode.py

diff --git a/src/neoskills/core/frontmatter.py b/src/neoskills/core/frontmatter.py
index 36bef83..151195b 100644
--- a/src/neoskills/core/frontmatter.py
+++ b/src/neoskills/core/frontmatter.py
@@ -39,7 +39,9 @@ def parse_frontmatter(content: str) -> tuple[dict[str, Any], str]:
 
 def write_frontmatter(metadata: dict[str, Any], body: str) -> str:
     """Combine YAML frontmatter and markdown body into a SKILL.md string."""
-    frontmatter = yaml.dump(metadata, default_flow_style=False, sort_keys=False).strip()
+    frontmatter = yaml.dump(
+        metadata, default_flow_style=False, sort_keys=False, allow_unicode=True
+    ).strip()
     return f"---\n{frontmatter}\n---\n\n{body}\n"
 
 
diff --git a/tests/unit/test_frontmatter_unicode.py b/tests/unit/test_frontmatter_unicode.py
new file mode 100644
index 0000000..c127f18
--- /dev/null
+++ b/tests/unit/test_frontmatter_unicode.py
@@ -0,0 +1,43 @@
+"""frontmatter 中文往返测试。
+
+背景：v0.4.2 的 write_frontmatter 用 yaml.dump 默认参数写盘，
+非 ASCII 字符会被转义成 "\\u6F14\\u793A" 形式。YAML 语义上等价，
+但 ① 人不可读 ② 部分只做正则/字符串匹配的 agent 读不到中文描述，
+导致技能描述形同虚设。这里锁死"写出去的中文必须还是中文"。
+"""
+
+from __future__ import annotations
+
+from neoskills.core.frontmatter import parse_frontmatter, write_frontmatter
+
+
+def test_chinese_description_roundtrip():
+    metadata = {"name": "demo-skill", "description": "演示：把会议录音整理成纪要"}
+    body = "# Demo Skill\n\n正文。"
+
+    text = write_frontmatter(metadata, body)
+
+    assert "演示：把会议录音整理成纪要" in text, "中文被转义成了 \\uXXXX"
+    assert "\\u6F14" not in text
+
+    parsed, parsed_body = parse_frontmatter(text)
+    assert parsed["description"] == metadata["description"]
+    assert parsed_body.strip() == body.strip()
+
+
+def test_ascii_only_unchanged():
+    metadata = {"name": "plain", "description": "A plain ascii description"}
+    text = write_frontmatter(metadata, "body")
+    assert "description: A plain ascii description" in text
+
+
+def test_nested_and_list_values_preserved():
+    metadata = {
+        "name": "混合",
+        "tags": ["中文标签", "ascii-tag"],
+        "extra": {"note": "嵌套里的中文"},
+    }
+    text = write_frontmatter(metadata, "body")
+    parsed, _ = parse_frontmatter(text)
+    assert parsed["tags"] == metadata["tags"]
+    assert parsed["extra"]["note"] == "嵌套里的中文"
